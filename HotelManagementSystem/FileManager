import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.io.FileWriter;
import java.io.IOException;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.List;

// Handles all reading/writing of bookings.txt, so booking persistence logic
// stays out of HotelManager and Booking.
// File format (pipe-separated): id|name|phone|email|roomNumber|checkIn|checkOut|addOn1;addOn2
public class FileManager {

    private static final String FILE_NAME = "bookings.txt";

    // Appends a single new booking to the file (called right after a booking is created)
    public static void saveBooking(Booking booking) {
        try (FileWriter writer = new FileWriter(FILE_NAME, true)) {
            writer.write(toLine(booking) + System.lineSeparator());
        } catch (IOException e) {
            System.out.println("Could not save booking to file: " + e.getMessage());
        }
    }

    // Overwrites the whole file with the current in-memory bookings.
    // Used after a check-out, since a line needs to be removed rather than appended.
    public static void rewriteAll(List<Booking> bookings) {
        try (FileWriter writer = new FileWriter(FILE_NAME, false)) {
            for (Booking booking : bookings) {
                writer.write(toLine(booking) + System.lineSeparator());
            }
        } catch (IOException e) {
            System.out.println("Could not update bookings file: " + e.getMessage());
        }
    }

    // Reads bookings.txt (if it exists) and rebuilds Booking objects, matching
    // each saved room number against the rooms HotelManager already created
    public static List<Booking> loadBookings(List<Room> knownRooms) {
        List<Booking> loaded = new ArrayList<>();
        File file = new File(FILE_NAME);
        if (!file.exists()) {
            return loaded; // nothing to load yet, first run
        }

        try (BufferedReader reader = new BufferedReader(new FileReader(file))) {
            String line;
            while ((line = reader.readLine()) != null) {
                if (line.isBlank()) continue;

                String[] parts = line.split("\\|", -1);
                int id = Integer.parseInt(parts[0]);
                Guest guest = new Guest(parts[1], parts[2], parts[3]);
                Room room = findRoomByNumber(knownRooms, parts[4]);

                if (room == null) {
                    // Room no longer exists in this run's room list -- skip this line
                    continue;
                }

                LocalDate checkIn = LocalDate.parse(parts[5]);
                LocalDate checkOut = LocalDate.parse(parts[6]);

                Booking.Builder builder = new Booking.Builder()
                        .bookingId(id)
                        .guest(guest)
                        .room(room)
                        .checkIn(checkIn)
                        .checkOut(checkOut);

                if (parts.length > 7 && !parts[7].isEmpty()) {
                    for (String addOn : parts[7].split(";")) {
                        builder.addOn(addOn);
                    }
                }

                Booking booking = builder.build();
                room.setBooked(true);
                loaded.add(booking);
            }
        } catch (IOException e) {
            System.out.println("Could not load existing bookings: " + e.getMessage());
        }

        return loaded;
    }

    private static Room findRoomByNumber(List<Room> rooms, String roomNumber) {
        for (Room room : rooms) {
            if (room.getRoomNumber().equals(roomNumber)) {
                return room;
            }
        }
        return null;
    }

    private static String toLine(Booking booking) {
        return booking.getBookingId() + "|" +
                booking.getGuest().getName() + "|" +
                booking.getGuest().getPhone() + "|" +
                booking.getGuest().getEmail() + "|" +
                booking.getRoom().getRoomNumber() + "|" +
                booking.getCheckIn() + "|" +
                booking.getCheckOut() + "|" +
                String.join(";", booking.getAddOns());
    }
}
