import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.awt.event.KeyAdapter;
import java.awt.event.KeyEvent;
import java.util.Random;

public class SnakeGame extends JFrame {

    public SnakeGame() {
        this.setTitle("Snake Game");
        this.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        this.setResizable(false);
        this.add(new GamePanel());
        this.pack(); // sizes the window to fit GamePanel's preferred size exactly
        this.setLocationRelativeTo(null); // centers the window on screen
        this.setVisible(true);
    }

    public static void main(String[] args) {
        new SnakeGame();
    }
}

class GamePanel extends JPanel implements ActionListener {

    static final int TILE_SIZE = 25;
    static final int GRID_WIDTH = 20;
    static final int GRID_HEIGHT = 20;
    static final int SCREEN_WIDTH = TILE_SIZE * GRID_WIDTH;
    static final int SCREEN_HEIGHT = TILE_SIZE * GRID_HEIGHT;
    static final int MAX_SEGMENTS = GRID_WIDTH * GRID_HEIGHT;
    static final int DELAY = 120; // milliseconds between game ticks (lower = faster snake)

    final int[] snakeX = new int[MAX_SEGMENTS];
    final int[] snakeY = new int[MAX_SEGMENTS];
    int snakeLength;

    int foodX;
    int foodY;

    char direction = 'R'; // U, D, L, R — starts moving Right
    boolean running = false;
    int score = 0;

    Timer timer;
    Random random;

    public GamePanel() {
        random = new Random();
        this.setPreferredSize(new Dimension(SCREEN_WIDTH, SCREEN_HEIGHT));
        this.setBackground(Color.BLACK);
        this.setFocusable(true); // required for KeyListener to receive events
        this.addKeyListener(new SnakeKeyAdapter());
        startGame();
    }

    void startGame() {
        snakeLength = 3;
        // Start the snake in the middle of the grid, all segments stacked at the same spot
        for (int i = 0; i < snakeLength; i++) {
            snakeX[i] = (GRID_WIDTH / 2) * TILE_SIZE;
            snakeY[i] = (GRID_HEIGHT / 2) * TILE_SIZE;
        }
        direction = 'R';
        score = 0;
        spawnFood();
        running = true;

        timer = new Timer(DELAY, this);
        timer.start();
    }

    void spawnFood() {
        foodX = random.nextInt(GRID_WIDTH) * TILE_SIZE;
        foodY = random.nextInt(GRID_HEIGHT) * TILE_SIZE;
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        draw(g);
    }

    void draw(Graphics g) {
        if (running) {
            // Draw food
            g.setColor(Color.RED);
            g.fillOval(foodX, foodY, TILE_SIZE, TILE_SIZE);

            // Draw snake — head in a brighter green, body in a darker green
            for (int i = 0; i < snakeLength; i++) {
                if (i == 0) {
                    g.setColor(Color.GREEN);
                } else {
                    g.setColor(new Color(45, 180, 0));
                }
                g.fillRect(snakeX[i], snakeY[i], TILE_SIZE, TILE_SIZE);
            }

            // Draw score
            g.setColor(Color.WHITE);
            g.setFont(new Font("Arial", Font.BOLD, 20));
            g.drawString("Score: " + score, 10, 25);

        } else {
            gameOverScreen(g);
        }
    }

    void gameOverScreen(Graphics g) {
        g.setColor(Color.WHITE);
        g.setFont(new Font("Arial", Font.BOLD, 40));
        FontMetrics metrics = getFontMetrics(g.getFont());
        String message = "Game Over";
        g.drawString(message, (SCREEN_WIDTH - metrics.stringWidth(message)) / 2, SCREEN_HEIGHT / 2 - 20);

        g.setFont(new Font("Arial", Font.PLAIN, 20));
        String scoreMsg = "Final Score: " + score;
        FontMetrics metrics2 = getFontMetrics(g.getFont());
        g.drawString(scoreMsg, (SCREEN_WIDTH - metrics2.stringWidth(scoreMsg)) / 2, SCREEN_HEIGHT / 2 + 20);

        String restartMsg = "Press ENTER to Restart";
        g.drawString(restartMsg, (SCREEN_WIDTH - metrics2.stringWidth(restartMsg)) / 2, SCREEN_HEIGHT / 2 + 50);
    }

    void move() {
        // Shift every body segment to the position of the segment in front of it,
        // working backwards so we don't overwrite data we still need
        for (int i = snakeLength - 1; i > 0; i--) {
            snakeX[i] = snakeX[i - 1];
            snakeY[i] = snakeY[i - 1];
        }

        // Move the head based on current direction
        switch (direction) {
            case 'U': snakeY[0] -= TILE_SIZE; break;
            case 'D': snakeY[0] += TILE_SIZE; break;
            case 'L': snakeX[0] -= TILE_SIZE; break;
            case 'R': snakeX[0] += TILE_SIZE; break;
        }
    }

    void checkFoodCollision() {
        if (snakeX[0] == foodX && snakeY[0] == foodY) {
            snakeLength++;
            score++;
            spawnFood();
        }
    }

    void checkWallAndSelfCollision() {
        // Wall collision
        if (snakeX[0] < 0 || snakeX[0] >= SCREEN_WIDTH || snakeY[0] < 0 || snakeY[0] >= SCREEN_HEIGHT) {
            running = false;
        }

        // Self collision — head touching any body segment
        for (int i = 1; i < snakeLength; i++) {
            if (snakeX[0] == snakeX[i] && snakeY[0] == snakeY[i]) {
                running = false;
                break;
            }
        }

        if (!running) {
            timer.stop();
        }
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        if (running) {
            move();
            checkFoodCollision();
            checkWallAndSelfCollision();
        }
        repaint(); // triggers paintComponent() to redraw the screen
    }

    class SnakeKeyAdapter extends KeyAdapter {
        @Override
        public void keyPressed(KeyEvent e) {
            int key = e.getKeyCode();

            switch (key) {
                case KeyEvent.VK_UP:
                    if (direction != 'D') direction = 'U'; // can't reverse directly into itself
                    break;
                case KeyEvent.VK_DOWN:
                    if (direction != 'U') direction = 'D';
                    break;
                case KeyEvent.VK_LEFT:
                    if (direction != 'R') direction = 'L';
                    break;
                case KeyEvent.VK_RIGHT:
                    if (direction != 'L') direction = 'R';
                    break;
                case KeyEvent.VK_ENTER:
                    if (!running) {
                        startGame();
                    }
                    break;
            }
        }
    }
}
