public class Account {

    private String accountHolderName;
    private double balance;

    public Account(String accountHolderName, double balance) {
        this.accountHolderName = accountHolderName;
        this.balance = balance;
    }

    public double getBalance() {
        return balance;
    }

    public String getAccountHolderName() {
        return accountHolderName;
    }

    // "throws" in the signature tells the caller: "you must handle these exceptions"
    public void withdraw(double amount) throws InsufficientBalanceException, InvalidAmountException {

        if (amount <= 0) {
            throw new InvalidAmountException("Withdrawal amount must be positive. You entered: " + amount);
        }

        if (amount > balance) {
            throw new InsufficientBalanceException(
                "Insufficient balance! Available balance: Rs. " + balance + ", Requested: Rs. " + amount
            );
        }

        balance -= amount;
    }

}
